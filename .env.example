# ==============================================================================
# ProtonVPN OpenVPN / IKEv2 Credentials
# NOTE: You MUST have +pmp at the end of your username for port forwarding to work!
# Example: myusername+pmp
# ==============================================================================
PROTON_OPENVPN_USER=your_openvpn_username+pmp
PROTON_OPENVPN_PASSWORD=your_openvpn_password

# Country selection (e.g. India, Netherlands, Switzerland, Singapore)
SERVER_COUNTRIES=India

# City selection (e.g. Mumbai)
SERVER_CITIES=Mumbai

# Specific Server Selection (Optional: leave blank for auto selection)
# Available India servers in ProtonVPN: IN#13, IN#26, IN#37, IN#41
SERVER_NAMES=

# ==============================================================================
# Port & Binding Configuration
# ==============================================================================
# Web Dashboard & Admin Portal Port (default: 8800)
# Set WEB_BIND=127.0.0.1 to restrict admin portal strictly to localhost!
WEB_PORT=8800
WEB_BIND=127.0.0.1

# famX Hardware Gateway & Telemetry Port (default: 5000)
# Hardware devices connect strictly to this port (forwarded via ProtonVPN)
DEVICE_PORT=5000
DEVICE_BIND=0.0.0.0

# Path to Gluetun dynamic forwarded port status file
FORWARDED_PORT_FILE=/gluetun/forwarded_port

# ==============================================================================
# Security & Telegram Bot Notifications
# ==============================================================================
SECRET_KEY=cybereye-secret-key-change-this-in-production
GEMINI_API_KEY=AIzaSyBsHMZ1SrAaMXdXScPGbycCZokkD5B3tP0

# Telegram Bot Notifications for Dynamic Public IP & Forwarded Port Changes
# 1. Create a bot using @BotFather on Telegram and paste the token below
TELEGRAM_BOT_TOKEN=
# 2. Get your numeric chat ID (using @userinfobot on Telegram) and paste below
TELEGRAM_CHAT_ID=
# Check interval in seconds to detect IP / Port changes (default: 30)
IP_PORT_CHECK_INTERVAL=30
