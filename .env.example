# ProtonVPN OpenVPN / IKEv2 Credentials
# NOTE: You MUST have +pmp at the end of your username for port forwarding to work!
PROTON_OPENVPN_USER=your_openvpn_username+pmp
PROTON_OPENVPN_PASSWORD=your_openvpn_password

# Country selection (e.g. India, Netherlands, Switzerland, Singapore)
SERVER_COUNTRIES=India

# City selection (e.g. Mumbai)
SERVER_CITIES=Mumbai

# Specific Server Selection (Optional: leave blank or commented out for auto selection)
# Available India servers in ProtonVPN: IN#13, IN#26
# SERVER_NAMES=IN#13
# Or multiple fallbacks:
# SERVER_NAMES=IN#13,IN#26

# Private Local Port to access the Admin Dashboard (default: 8080)
# Visit: http://localhost:8080 (never forwarded over VPN)
DASHBOARD_PORT=8080

# Internal Agent Data Collection Port (default: 5000)
# ProtonVPN forwards external public port strictly to this endpoint
PORT=5000

# Path to the CyberEye monitoring server files (defaults to ./CYBER_EYE1)
APP_DIR=./CYBER_EYE1

# Telegram Bot Notifications for IP & Port Forwarding
# 1. Create a bot using @BotFather on Telegram and paste the token below
TELEGRAM_BOT_TOKEN=
# 2. Get your numeric chat ID (using @userinfobot on Telegram) and paste below
TELEGRAM_CHAT_ID=
# Check interval in seconds to detect IP / Port changes (default: 30)
IP_PORT_CHECK_INTERVAL=30
